(sort term)

(sort wff provable)

--| Define "term" and "wff"
(term tze () (term ()))

(term tpl ((t term ()) (r term ())) (term ()))

(term weq ((t term ()) (r term ())) (wff ()))

(term wim ((P wff ()) (Q wff ())) (wff ()))

--| State the axioms
(axiom a1 ((t term ()) (r term ()) (s term ()))
  ()
  (wim (weq t r) (wim (weq t s) (weq r s))))

(axiom a2 ((t term ()))
  ()
  (weq (tpl t (tze)) t))

(axiom mp ((P wff ()) (Q wff ()))
  (P
    (wim P Q))
  Q)

--| Prove a theorem (Contributed by ?who?, 11-Jan-2026.)
(pub theorem th1 ((t term ()))
  ()
  (weq t t)
  ()
  (mp ((weq (tpl t (tze)) t) (weq t t))
    (a2 (t))
    (mp ((weq (tpl t (tze)) t) (wim (weq (tpl t (tze)) t) (weq t t)))
      (a2 (t))
      (a1 ((tpl t (tze)) t t)))))

