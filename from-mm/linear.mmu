(sort nilad)

(sort var)

(sort wff provable)

--| Bottom, the unit of `%`. In the resource interpretation, this represents an impossibility. Characterized by ~ax-ibot and ~ax-ebot .
(term wbot () (wff ()))

--| Par, multiplicative disjunction. In the resource interpretation, this represents resources that are to be used in parallel. Characterized by ~ax-init , ~ax-cut , ~ax-mdco , ~ax-mdas .
(term wmd ((ph wff ()) (ps wff ())) (wff ()))

--| Linear negation. For any statement `ph`, `~ ph` is its dual. In the resource interpretation, this represents demand for something (sort of kind of). Combining `ph` and `~ ph` yields `_|_`.
(term wneg ((ph wff ())) (wff ()))

--| Add a `_|_`. Inverse of ~ax-ebot .
(axiom ax_ibot ((ph wff ()))
  (ph)
  (wmd (wbot) ph))

--| Remove a `_|_`. Inverse of ~ax-ibot .
(axiom ax_ebot ((ph wff ()))
  ((wmd (wbot) ph))
  ph)

--| The cut rule is akin to syllogism in classical logic. It allows `~ ph % ps` to act like an implication, so that an `ph` can be removed and traded for a `ps`.
(axiom ax_cut ((ph wff ()) (ps wff ()) (ch wff ()))
  ((wmd ph ps)
    (wmd (wneg ps) ch))
  (wmd ph ch))

--| The _init_ rule. This innocent-looking rule looks similar to the Law of Excluded Middle in classical logic, but don't be fooled. This allows us to turn any deduction into its dual by simply performing operations on the `~ ph` side and flipping it around to get the reverse implication. This is analogous to using modus tollens in classical logic, but it's especially useful in linear logic because it allows each operator to be defined as its dual with all of the deductions negated and backwards.
(axiom ax_init ((ph wff ()))
  ()
  (wmd (wneg ph) ph))

--| `%` is commutative.
(axiom ax_mdco ((ph wff ()) (ps wff ()))
  ()
  (wmd (wneg (wmd ph ps)) (wmd ps ph)))

--| `%` is associative.
(axiom ax_mdas ((ph wff ()) (ps wff ()) (ch wff ()))
  ()
  (wmd (wneg (wmd (wmd ph ps) ch)) (wmd ph (wmd ps ch))))

--| Modus ponens like inference.
(pub theorem cut1 ((ph wff ()) (ps wff ()))
  ((cut1_1 ph)
    (cut1_2 (wmd (wneg ph) ps)))
  ps
  ()
  (ax_ebot (ps)
    (ax_cut ((wbot) ph ps)
      (ax_ibot (ph)
        cut1_1)
      cut1_2)))

--| `%` is commutative. Deduction form of ~ax-mdco .
(pub theorem mdcod ((ph wff ()) (ps wff ()) (th wff ()))
  ((mdcod_1 (wmd th (wmd ph ps))))
  (wmd th (wmd ps ph))
  ()
  (ax_cut (th (wmd ph ps) (wmd ps ph))
    mdcod_1
    (ax_mdco (ph ps))))

--| `%` is commutative. Inference form of ~ax-mdco .
(pub theorem mdcoi ((ph wff ()) (ps wff ()))
  ((mdcoi_1 (wmd ph ps)))
  (wmd ps ph)
  ()
  (cut1 ((wmd ph ps) (wmd ps ph))
    mdcoi_1
    (ax_mdco (ph ps))))

--| `%` is associative. Deduction form of ~ax-mdas .
(pub theorem mdasd ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((mdasd_1 (wmd th (wmd (wmd ph ps) ch))))
  (wmd th (wmd ph (wmd ps ch)))
  ()
  (ax_cut (th (wmd (wmd ph ps) ch) (wmd ph (wmd ps ch)))
    mdasd_1
    (ax_mdas (ph ps ch))))

--| `%` is associative. Inference form of ~ax-mdas .
(pub theorem mdasi ((ph wff ()) (ps wff ()) (ch wff ()))
  ((mdasi_1 (wmd (wmd ph ps) ch)))
  (wmd ph (wmd ps ch))
  ()
  (cut1 ((wmd (wmd ph ps) ch) (wmd ph (wmd ps ch)))
    mdasi_1
    (ax_mdas (ph ps ch))))

--| `%` is associative. Reverse of ~ax-mdas .
(pub theorem mdasr ((ph wff ()) (ps wff ()) (ch wff ()))
  ()
  (wmd (wneg (wmd ph (wmd ps ch))) (wmd (wmd ph ps) ch))
  ()
  (ax_cut ((wneg (wmd ph (wmd ps ch))) (wmd ch (wmd ph ps)) (wmd (wmd ph ps) ch))
    (ax_cut ((wneg (wmd ph (wmd ps ch))) (wmd (wmd ch ph) ps) (wmd ch (wmd ph ps)))
      (ax_cut ((wneg (wmd ph (wmd ps ch))) (wmd ps (wmd ch ph)) (wmd (wmd ch ph) ps))
        (ax_cut ((wneg (wmd ph (wmd ps ch))) (wmd (wmd ps ch) ph) (wmd ps (wmd ch ph)))
          (ax_mdco (ph (wmd ps ch)))
          (ax_mdas (ps ch ph)))
        (ax_mdco (ps (wmd ch ph))))
      (ax_mdas (ch ph ps)))
    (ax_mdco (ch (wmd ph ps)))))

--| `%` is associative. Deduction form of ~mdasr .
(pub theorem mdasrd ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((mdasrd_1 (wmd th (wmd ph (wmd ps ch)))))
  (wmd th (wmd (wmd ph ps) ch))
  ()
  (ax_cut (th (wmd ph (wmd ps ch)) (wmd (wmd ph ps) ch))
    mdasrd_1
    (mdasr (ph ps ch))))

--| `%` is associative. Inference form of ~mdasrd .
(pub theorem mdasri ((ph wff ()) (ps wff ()) (ch wff ()))
  ((mdasri_1 (wmd ph (wmd ps ch))))
  (wmd (wmd ph ps) ch)
  ()
  (ax_ebot ((wmd (wmd ph ps) ch))
    (mdasrd (ph ps ch (wbot))
      (ax_ibot ((wmd ph (wmd ps ch)))
        mdasri_1))))

--| Add a `_|_`, right hand side. See ~ax-ibot .
(pub theorem ibotr ((ph wff ()))
  ((ibotr_1 ph))
  (wmd ph (wbot))
  ()
  (mdcoi ((wbot) ph)
    (ax_ibot (ph)
      ibotr_1)))

--| Remove a `_|_`, right hand side. See ~ax-ebot .
(pub theorem ebotr ((ph wff ()))
  ((ebotr_1 (wmd ph (wbot))))
  ph
  ()
  (ax_ebot (ph)
    (mdcoi (ph (wbot))
      ebotr_1)))

--| Infer `~ _|_` (secretly `1`).
(pub theorem nebot ()
  ()
  (wneg (wbot))
  ()
  (ebotr ((wneg (wbot)))
    (ax_init ((wbot)))))

--| Negated version of ~ax-cut .
(pub theorem cutneg ((ph wff ()) (ps wff ()) (ch wff ()))
  ((cutneg_1 (wmd ph (wneg ps)))
    (cutneg_2 (wmd ps ch)))
  (wmd ph ch)
  ()
  (mdcoi (ch ph)
    (ax_cut (ch ps ph)
      (mdcoi (ps ch)
        cutneg_2)
      (mdcoi (ph (wneg ps))
        cutneg_1))))

--| Left-hand version of ~ax-cut .
(pub theorem cutf ((ph wff ()) (ps wff ()) (ch wff ()))
  ((cutf_1 (wmd ps ph))
    (cutf_2 (wmd (wneg ps) ch)))
  (wmd ch ph)
  ()
  (mdcoi (ph ch)
    (ax_cut (ph ps ch)
      (mdcoi (ps ph)
        cutf_1)
      cutf_2)))

--| Double negation introduction.
(pub theorem dnid ((ph wff ()) (ps wff ()))
  ((dnid_1 (wmd ph ps)))
  (wmd ph (wneg (wneg ps)))
  ()
  (ax_cut (ph ps (wneg (wneg ps)))
    dnid_1
    (mdcoi ((wneg (wneg ps)) (wneg ps))
      (ax_init ((wneg ps))))))

--| Double negation elimination.
(pub theorem dned ((ph wff ()) (ps wff ()))
  ((dned_1 (wmd ph (wneg (wneg ps)))))
  (wmd ph ps)
  ()
  (ax_cut (ph (wneg (wneg ps)) ps)
    dned_1
    (mdcoi (ps (wneg (wneg (wneg ps))))
      (dnid (ps (wneg ps))
        (mdcoi ((wneg ps) ps)
          (ax_init (ps)))))))

--| Double negation introduction, left hand side.
(pub theorem dni1 ((ph wff ()) (ps wff ()))
  ((dni1_1 (wmd ph ps)))
  (wmd (wneg (wneg ph)) ps)
  ()
  (mdcoi (ps (wneg (wneg ph)))
    (dnid (ps ph)
      (mdcoi (ph ps)
        dni1_1))))

--| Double negation elimination, left hand side.
(pub theorem dne1 ((ph wff ()) (ps wff ()))
  ((dne1_1 (wmd (wneg (wneg ph)) ps)))
  (wmd ph ps)
  ()
  (mdcoi (ps ph)
    (dned (ps ph)
      (mdcoi ((wneg (wneg ph)) ps)
        dne1_1))))

--| Add a `~ ~ _|_`. See ~ax-ibot . This is useful for dealing with deductions where the antecedent is negated.
(pub theorem inenebot ((ph wff ()))
  ((inenebot_1 ph))
  (wmd (wneg (wneg (wbot))) ph)
  ()
  (dni1 ((wbot) ph)
    (ax_ibot (ph)
      inenebot_1)))

--| Remove a `~ ~ _|_`. Inverse of ~inenebot .
(pub theorem enenebot ((ph wff ()))
  ((enenebot_1 (wmd (wneg (wneg (wbot))) ph)))
  ph
  ()
  (ax_ebot (ph)
    (dne1 ((wbot) ph)
      enenebot_1)))

--| Top, the unit of `&`. In the resource interpretation, this represents an unknown collection of objects. Characterized by ~ax-top .
(term wtop () (wff ()))

--| With, additive conjunction. In the resource interpretation, this represents a choice between two resources. Characterized by ~ax-iac , ~ax-eac1 , ~ax-eac2 .
(term wac ((ph wff ()) (ps wff ())) (wff ()))

--| Anything can turn into ` ``|`` `.
(axiom ax_top ((ph wff ()))
  ()
  (wmd (wneg ph) (wtop)))

--| `&` introduction rule.
(axiom ax_iac ((ph wff ()) (ps wff ()) (ch wff ()))
  ((wmd (wneg ph) ps)
    (wmd (wneg ph) ch))
  (wmd (wneg ph) (wac ps ch)))

--| `&` elimination rule, left hand side.
(axiom ax_eac1 ((ph wff ()) (ps wff ()) (ch wff ()))
  ((wmd (wneg ph) (wac ps ch)))
  (wmd (wneg ph) ps))

--| `&` elimination rule, right hand side.
(axiom ax_eac2 ((ph wff ()) (ps wff ()) (ch wff ()))
  ((wmd (wneg ph) (wac ps ch)))
  (wmd (wneg ph) ch))

--| `&` introduction rule. ~ax-iac has a negation for some reason, this one doesn't.
(pub theorem iac ((ph wff ()) (ps wff ()) (ch wff ()))
  ((iac_1 (wmd ph ps))
    (iac_2 (wmd ph ch)))
  (wmd ph (wac ps ch))
  ()
  (dne1 (ph (wac ps ch))
    (ax_iac ((wneg ph) ps ch)
      (dni1 (ph ps)
        iac_1)
      (dni1 (ph ch)
        iac_2))))

--| `&` introduction rule. Inference form of ~ax-iac .
(pub theorem iaci ((ph wff ()) (ps wff ()))
  ((iaci_1 ph)
    (iaci_2 ps))
  (wac ph ps)
  ()
  (ax_ebot ((wac ph ps))
    (iac ((wbot) ph ps)
      (ax_ibot (ph)
        iaci_1)
      (ax_ibot (ps)
        iaci_2))))

--| `&` elimination rule, left hand side. ~ax-eac1 has a negation for some reason, this one doesn't.
(pub theorem eac1d ((ph wff ()) (ps wff ()) (ch wff ()))
  ((eac1d_1 (wmd ph (wac ps ch))))
  (wmd ph ps)
  ()
  (dne1 (ph ps)
    (ax_eac1 ((wneg ph) ps ch)
      (dni1 (ph (wac ps ch))
        eac1d_1))))

--| `&` elimination rule, left hand side. Inference form of ~ax-eac1 .
(pub theorem eac1i ((ph wff ()) (ps wff ()))
  ((eac1i_1 (wac ph ps)))
  ph
  ()
  (enenebot (ph)
    (ax_eac1 ((wneg (wbot)) ph ps)
      (inenebot ((wac ph ps))
        eac1i_1))))

--| `&` elimination rule, right hand side. ~ax-eac2 has a negation for some reason, this one doesn't.
(pub theorem eac2d ((ph wff ()) (ps wff ()) (ch wff ()))
  ((eac2d_1 (wmd ph (wac ps ch))))
  (wmd ph ch)
  ()
  (dne1 (ph ch)
    (ax_eac2 ((wneg ph) ps ch)
      (dni1 (ph (wac ps ch))
        eac2d_1))))

--| `&` elimination rule, right hand side. Inference form of ~ax-eac2 .
(pub theorem eac2i ((ph wff ()) (ps wff ()))
  ((eac2i_1 (wac ph ps)))
  ps
  ()
  (enenebot (ps)
    (ax_eac2 ((wneg (wbot)) ph ps)
      (inenebot ((wac ph ps))
        eac2i_1))))

--| Insert Top into With. Inverse of ~etopi .
(pub theorem itopi ((ph wff ()))
  ((itopi_1 ph))
  (wac ph (wtop))
  ()
  (cut1 (ph (wac ph (wtop)))
    itopi_1
    (ax_iac (ph ph (wtop))
      (ax_init (ph))
      (ax_top (ph)))))

--| Remove Top from With. This is, of course, just a special case of ~ax-eac1 .
(pub theorem etopi ((ph wff ()))
  ((etopi_1 (wac ph (wtop))))
  ph
  ()
  (eac1i (ph (wtop))
    etopi_1))

--| `&` is commutative.
(pub theorem acco ((ph wff ()) (ps wff ()) (ch wff ()))
  ((acco_1 (wmd ph (wac ps ch))))
  (wmd ph (wac ch ps))
  ()
  (iac (ph ch ps)
    (eac2d (ph ps ch)
      acco_1)
    (eac1d (ph ps ch)
      acco_1)))

--| `&` is associative.
(pub theorem acas ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((acas_1 (wmd ph (wac (wac ps ch) th))))
  (wmd ph (wac ps (wac ch th)))
  ()
  (iac (ph ps (wac ch th))
    (eac1d (ph ps ch)
      (eac1d (ph (wac ps ch) th)
        acas_1))
    (iac (ph ch th)
      (eac2d (ph ps ch)
        (eac1d (ph (wac ps ch) th)
          acas_1))
      (eac2d (ph (wac ps ch) th)
        acas_1))))

--| `&` is associative. Reverse of ~acas .
(pub theorem acasr ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((acasr_1 (wmd ph (wac ps (wac ch th)))))
  (wmd ph (wac (wac ps ch) th))
  ()
  (iac (ph (wac ps ch) th)
    (iac (ph ps ch)
      (eac1d (ph ps (wac ch th))
        acasr_1)
      (eac1d (ph ch th)
        (eac2d (ph ps (wac ch th))
          acasr_1)))
    (eac2d (ph ch th)
      (eac2d (ph ps (wac ch th))
        acasr_1))))

--| `%` distributes over `&`.
(pub theorem dismdac ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((dismdac_1 (wmd ph (wmd ps (wac ch th)))))
  (wmd ph (wac (wmd ps ch) (wmd ps th)))
  ()
  (iac (ph (wmd ps ch) (wmd ps th))
    (mdasi (ph ps ch)
      (eac1d ((wmd ph ps) ch th)
        (mdasri (ph ps (wac ch th))
          dismdac_1)))
    (mdasi (ph ps th)
      (eac2d ((wmd ph ps) ch th)
        (mdasri (ph ps (wac ch th))
          dismdac_1)))))

--| `%` extracts out of `&`. Converse of ~dismdac .
(pub theorem extmdac ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((extmdac_1 (wmd ph (wac (wmd ps ch) (wmd ps th)))))
  (wmd ph (wmd ps (wac ch th)))
  ()
  (mdasi (ph ps (wac ch th))
    (iac ((wmd ph ps) ch th)
      (mdasri (ph ps ch)
        (eac1d (ph (wmd ps ch) (wmd ps th))
          extmdac_1))
      (mdasri (ph ps th)
        (eac2d (ph (wmd ps ch) (wmd ps th))
          extmdac_1)))))

--| "Why not", negative exponential. Characterized by ~ax-ipe , ~ax-epe , ~ax-weak , ~ax-contr , ~ax-pemc , ~ax-dig .
(term wne ((ph wff ())) (wff ()))

--| Add a `?` (secretly a `!`). Inverse of ~ax-epe .
(axiom ax_ipe ((ph wff ()) (ps wff ()))
  ((wmd (wneg ph) (wne ps)))
  (wmd (wneg (wne ph)) (wne ps)))

--| Remove a `?` (secretly a `!`). Inverse of ~ax-ipe .
(axiom ax_epe ((ph wff ()) (ps wff ()))
  ((wmd (wneg (wne ph)) (wne ps)))
  (wmd (wneg ph) (wne ps)))

--| `? ph` can be added into any statement.
(axiom ax_weak ((ph wff ()))
  ()
  (wmd (wneg (wbot)) (wne ph)))

--| `? ph` can be contracted.
(axiom ax_contr ((ph wff ()))
  ()
  (wmd (wneg (wmd (wne ph) (wne ph))) (wne ph)))

--| `! 1`. This is needed to let ~ax-ipe and ~ax-epe work on single items.
(axiom ax_pemc ()
  ()
  (wneg (wne (wbot))))

--| If all the elements of a multiplicative disjunction have `?`, then `?` can be removed from that disjunction.
(axiom ax_dig ((ph wff ()) (ps wff ()))
  ()
  (wmd (wneg (wne (wmd (wne ph) (wne ps)))) (wmd (wne ph) (wne ps))))

--| Linear biconditional, defined by ~df-lb . This is the operator used for definitions, so its definition will be a little unusual...
(term wlb ((ph wff ()) (ps wff ())) (wff ()))

--| Definition of linear biconditional. Since the linear implication has not been defined, this is a mouthfull. The good news is, once the properties of the linear biconditional are proven, it will be much easier to express other definitions. See ~dflb for a cleaner form of the definition.
(axiom df_lb ((ph wff ()) (ps wff ()))
  ()
  (wac (wmd (wneg (wlb ph ps)) (wac (wmd (wneg ph) ps) (wmd (wneg ps) ph))) (wmd (wneg (wac (wmd (wneg ph) ps) (wmd (wneg ps) ph))) (wlb ph ps))))

--| Forward deduction using `O-O`.
(pub theorem lb1d ((ph wff ()) (ps wff ()) (ch wff ()))
  ((lb1d_1 (wmd ph ps))
    (lb1d_2 (wlb ps ch)))
  (wmd ph ch)
  ()
  (ax_cut (ph ps ch)
    lb1d_1
    (eac1i ((wmd (wneg ps) ch) (wmd (wneg ch) ps))
      (cut1 ((wlb ps ch) (wac (wmd (wneg ps) ch) (wmd (wneg ch) ps)))
        lb1d_2
        (eac1i ((wmd (wneg (wlb ps ch)) (wac (wmd (wneg ps) ch) (wmd (wneg ch) ps))) (wmd (wneg (wac (wmd (wneg ps) ch) (wmd (wneg ch) ps))) (wlb ps ch)))
          (df_lb (ps ch)))))))

--| Reverse deduction using `O-O`.
(pub theorem lb2d ((ph wff ()) (ps wff ()) (ch wff ()))
  ((lb2d_1 (wmd ph ch))
    (lb2d_2 (wlb ps ch)))
  (wmd ph ps)
  ()
  (ax_cut (ph ch ps)
    lb2d_1
    (eac2i ((wmd (wneg ps) ch) (wmd (wneg ch) ps))
      (cut1 ((wlb ps ch) (wac (wmd (wneg ps) ch) (wmd (wneg ch) ps)))
        lb2d_2
        (eac1i ((wmd (wneg (wlb ps ch)) (wac (wmd (wneg ps) ch) (wmd (wneg ch) ps))) (wmd (wneg (wac (wmd (wneg ps) ch) (wmd (wneg ch) ps))) (wlb ps ch)))
          (df_lb (ps ch)))))))

--| Forward inference using `O-O`.
(pub theorem lb1i ((ph wff ()) (ps wff ()))
  ((lb1i_1 ph)
    (lb1i_2 (wlb ph ps)))
  ps
  ()
  (ax_ebot (ps)
    (lb1d ((wbot) ph ps)
      (ax_ibot (ph)
        lb1i_1)
      lb1i_2)))

--| Reverse inference using `O-O`.
(pub theorem lb2i ((ph wff ()) (ps wff ()))
  ((lb2i_1 ps)
    (lb2i_2 (wlb ph ps)))
  ph
  ()
  (ax_ebot (ph)
    (lb2d ((wbot) ph ps)
      (ax_ibot (ps)
        lb2i_1)
      lb2i_2)))

--| Linear implication, defined by ~df-li . Now that linear implication exists, we can finally put things in syllogism form from here on.
(term wli ((ph wff ()) (ps wff ())) (wff ()))

--| Definition of linear implication.
(axiom df_li ((ph wff ()) (ps wff ()))
  ()
  (wlb (wli ph ps) (wmd (wneg ph) ps)))

--| Convert from linear implication.
(pub theorem dfli1 ((ph wff ()) (ps wff ()) (ch wff ()))
  ((dfli1_1 (wmd ph (wli ps ch))))
  (wmd ph (wmd (wneg ps) ch))
  ()
  (lb1d (ph (wli ps ch) (wmd (wneg ps) ch))
    dfli1_1
    (df_li (ps ch))))

--| Convert to linear implication.
(pub theorem dfli2 ((ph wff ()) (ps wff ()) (ch wff ()))
  ((dfli2_1 (wmd ph (wmd (wneg ps) ch))))
  (wmd ph (wli ps ch))
  ()
  (lb2d (ph (wli ps ch) (wmd (wneg ps) ch))
    dfli2_1
    (df_li (ps ch))))

--| Convert from linear implication. Inference for ~dfli1 .
(pub theorem dfli1i ((ps wff ()) (ch wff ()))
  ((dfli1i_1 (wli ps ch)))
  (wmd (wneg ps) ch)
  ()
  (ax_ebot ((wmd (wneg ps) ch))
    (dfli1 ((wbot) ps ch)
      (ax_ibot ((wli ps ch))
        dfli1i_1))))

--| Convert to linear implication. Inference for ~dfli2 .
(pub theorem dfli2i ((ps wff ()) (ch wff ()))
  ((dfli2i_1 (wmd (wneg ps) ch)))
  (wli ps ch)
  ()
  (ax_ebot ((wli ps ch))
    (dfli2 ((wbot) ps ch)
      (ax_ibot ((wmd (wneg ps) ch))
        dfli2i_1))))

--| Forward syllogism using `O-O`.
(pub theorem lb1s ((ph wff ()) (ps wff ()) (ch wff ()))
  ((lb1s_1 (wli ph ps))
    (lb1s_2 (wlb ps ch)))
  (wli ph ch)
  ()
  (dfli2i (ph ch)
    (lb1d ((wneg ph) ps ch)
      (dfli1i (ph ps)
        lb1s_1)
      lb1s_2)))

--| Reverse syllogism using `O-O`.
(pub theorem lb2s ((ph wff ()) (ps wff ()) (ch wff ()))
  ((lb2s_1 (wli ph ch))
    (lb2s_2 (wlb ps ch)))
  (wli ph ps)
  ()
  (dfli2i (ph ps)
    (lb2d ((wneg ph) ps ch)
      (dfli1i (ph ch)
        lb2s_1)
      lb2s_2)))

--| Par is monotone in its second argument.
(pub theorem mdm2 ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((mdm2_1 (wmd th (wmd ph ps)))
    (mdm2_2 (wli ps ch)))
  (wmd th (wmd ph ch))
  ()
  (mdasi (th ph ch)
    (ax_cut ((wmd th ph) ps ch)
      (mdasri (th ph ps)
        mdm2_1)
      (lb1i ((wli ps ch) (wmd (wneg ps) ch))
        mdm2_2
        (df_li (ps ch))))))

--| Par is monotone in its first argument.
(pub theorem mdm1 ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((mdm1_1 (wmd th (wmd ph ps)))
    (mdm1_2 (wli ph ch)))
  (wmd th (wmd ch ps))
  ()
  (mdcod (ps ch th)
    (mdm2 (ps ph ch th)
      (mdcod (ph ps th)
        mdm1_1)
      mdm1_2)))

--| Par is monotone in its first argument. Inference form of ~mdm1 .
(pub theorem mdm1i ((ph wff ()) (ps wff ()) (ch wff ()))
  ((mdm1i_1 (wmd ph ps))
    (mdm1i_2 (wli ph ch)))
  (wmd ch ps)
  ()
  (ax_ebot ((wmd ch ps))
    (mdm1 (ph ps ch (wbot))
      (ax_ibot ((wmd ph ps))
        mdm1i_1)
      mdm1i_2)))

--| Par is monotone in its second argument. Inference form of ~mdm2 . Essentially ~ax-cut using linear implication.
(pub theorem mdm2i ((ph wff ()) (ps wff ()) (ch wff ()))
  ((mdm2i_1 (wmd ph ps))
    (mdm2i_2 (wli ps ch)))
  (wmd ph ch)
  ()
  (ax_ebot ((wmd ph ch))
    (mdm2 (ph ps ch (wbot))
      (ax_ibot ((wmd ph ps))
        mdm2i_1)
      mdm2i_2)))

--| Par is monotone in its first argument. Syllogism form of ~mdm1 .
(pub theorem mdm1s ((ph wff ()) (ps wff ()) (ch wff ()))
  ((mdm1s_1 (wli ph ch)))
  (wli (wmd ph ps) (wmd ch ps))
  ()
  (dfli2i ((wmd ph ps) (wmd ch ps))
    (mdm1 (ph ps ch (wneg (wmd ph ps)))
      (ax_init ((wmd ph ps)))
      mdm1s_1)))

--| Par is monotone in its second argument. Syllogism form of ~mdm2 .
(pub theorem mdm2s ((ph wff ()) (ps wff ()) (ch wff ()))
  ((mdm2s_1 (wli ps ch)))
  (wli (wmd ph ps) (wmd ph ch))
  ()
  (dfli2i ((wmd ph ps) (wmd ph ch))
    (mdm2 (ph ps ch (wneg (wmd ph ps)))
      (ax_init ((wmd ph ps)))
      mdm2s_1)))

--| Syllogism using linear implication.
(pub theorem syl ((ph wff ()) (ps wff ()) (ch wff ()))
  ((syl_1 (wli ph ps))
    (syl_2 (wli ps ch)))
  (wli ph ch)
  ()
  (lb2i ((wli ph ch) (wmd (wneg ph) ch))
    (ax_cut ((wneg ph) ps ch)
      (lb1i ((wli ph ps) (wmd (wneg ph) ps))
        syl_1
        (df_li (ph ps)))
      (lb1i ((wli ps ch) (wmd (wneg ps) ch))
        syl_2
        (df_li (ps ch))))
    (df_li (ph ch))))

--| Modus ponens like inference using linear implication.
(pub theorem lmp ((ph wff ()) (ps wff ()))
  ((lmp_min ph)
    (lmp_maj (wli ph ps)))
  ps
  ()
  (ax_ebot (ps)
    (mdm2i ((wbot) ph ps)
      (ax_ibot (ph)
        lmp_min)
      lmp_maj)))

--| Identity rule for linear implication. Syllogism form of ~ax-init .
(pub theorem id ((ph wff ()))
  ()
  (wli ph ph)
  ()
  (lb2i ((wli ph ph) (wmd (wneg ph) ph))
    (ax_init (ph))
    (df_li (ph ph))))

--| Double negation introduction. Syllogism form of ~dnid .
(pub theorem dnis ((ph wff ()))
  ()
  (wli ph (wneg (wneg ph)))
  ()
  (lb2i ((wli ph (wneg (wneg ph))) (wmd (wneg ph) (wneg (wneg ph))))
    (mdcoi ((wneg (wneg ph)) (wneg ph))
      (ax_init ((wneg ph))))
    (df_li (ph (wneg (wneg ph))))))

--| Double negation elimination. Syllogism form of ~dned .
(pub theorem dnes ((ph wff ()))
  ()
  (wli (wneg (wneg ph)) ph)
  ()
  (lb2i ((wli (wneg (wneg ph)) ph) (wmd (wneg (wneg (wneg ph))) ph))
    (mdcoi (ph (wneg (wneg (wneg ph))))
      (ax_cut (ph (wneg ph) (wneg (wneg (wneg ph))))
        (mdcoi ((wneg ph) ph)
          (ax_init (ph)))
        (mdcoi ((wneg (wneg (wneg ph))) (wneg (wneg ph)))
          (ax_init ((wneg (wneg ph)))))))
    (df_li ((wneg (wneg ph)) ph))))

--| With is monotone in its first argument.
(pub theorem acm1 ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((acm1_1 (wmd th (wac ph ps)))
    (acm1_2 (wli ph ch)))
  (wmd th (wac ch ps))
  ()
  (iac (th ch ps)
    (mdm2i (th ph ch)
      (eac1d (th ph ps)
        acm1_1)
      acm1_2)
    (eac2d (th ph ps)
      acm1_1)))

--| With is monotone in its second argument.
(pub theorem acm2 ((ph wff ()) (ps wff ()) (ch wff ()) (th wff ()))
  ((acm2_1 (wmd th (wac ph ps)))
    (acm2_2 (wli ps ch)))
  (wmd th (wac ph ch))
  ()
  (acco (th ch ph)
    (acm1 (ps ph ch th)
      (acco (th ph ps)
        acm2_1)
      acm2_2)))

--| With is monotone in its first argument. Inference form of ~acm1 .
(pub theorem acm1i ((ph wff ()) (ps wff ()) (ch wff ()))
  ((acm1i_1 (wac ph ps))
    (acm1i_2 (wli ph ch)))
  (wac ch ps)
  ()
  (ax_ebot ((wac ch ps))
    (acm1 (ph ps ch (wbot))
      (ax_ibot ((wac ph ps))
        acm1i_1)
      acm1i_2)))

--| With is monotone in its second argument. Inference form of ~acm2 .
(pub theorem acm2i ((ph wff ()) (ps wff ()) (ch wff ()))
  ((acm2i_1 (wac ph ps))
    (acm2i_2 (wli ps ch)))
  (wac ph ch)
  ()
  (ax_ebot ((wac ph ch))
    (acm2 (ph ps ch (wbot))
      (ax_ibot ((wac ph ps))
        acm2i_1)
      acm2i_2)))

--| With is monotone in its first argument. Syllogism form of ~acm1 .
(pub theorem acm1s ((ph wff ()) (ps wff ()) (ch wff ()))
  ((acm1s_1 (wli ph ch)))
  (wli (wac ph ps) (wac ch ps))
  ()
  (dfli2i ((wac ph ps) (wac ch ps))
    (acm1 (ph ps ch (wneg (wac ph ps)))
      (ax_init ((wac ph ps)))
      acm1s_1)))

--| With is monotone in its second argument. Syllogism form of ~acm2 .
(pub theorem acm2s ((ph wff ()) (ps wff ()) (ch wff ()))
  ((acm2s_1 (wli ps ch)))
  (wli (wac ph ps) (wac ph ch))
  ()
  (dfli2i ((wac ph ps) (wac ph ch))
    (acm2 (ph ps ch (wneg (wac ph ps)))
      (ax_init ((wac ph ps)))
      acm2s_1)))

--| "Why not" is monotone.
(pub theorem nems ((ph wff ()) (ps wff ()))
  ((nems_1 (wli ph ps)))
  (wli (wne ph) (wne ps))
  ()
  (dfli2i ((wne ph) (wne ps))
    (ax_ipe (ph ps)
      (ax_cut ((wneg ph) ps (wne ps))
        (dfli1i (ph ps)
          nems_1)
        (ax_epe (ps ps)
          (ax_init ((wne ps))))))))

--| Extract forward implication from biconditional. Syllogism form of ~ lb1i .
(pub theorem lbi1s ((ph wff ()) (ps wff ()))
  ()
  (wli (wlb ph ps) (wli ph ps))
  ()
  (lb2i ((wli (wlb ph ps) (wli ph ps)) (wmd (wneg (wlb ph ps)) (wli ph ps)))
    (ax_cut ((wneg (wlb ph ps)) (wmd (wneg ph) ps) (wli ph ps))
      (ax_eac1 ((wlb ph ps) (wmd (wneg ph) ps) (wmd (wneg ps) ph))
        (eac1i ((wmd (wneg (wlb ph ps)) (wac (wmd (wneg ph) ps) (wmd (wneg ps) ph))) (wmd (wneg (wac (wmd (wneg ph) ps) (wmd (wneg ps) ph))) (wlb ph ps)))
          (df_lb (ph ps))))
      (eac2i ((wmd (wneg (wli ph ps)) (wmd (wneg ph) ps)) (wmd (wneg (wmd (wneg ph) ps)) (wli ph ps)))
        (cut1 ((wlb (wli ph ps) (wmd (wneg ph) ps)) (wac (wmd (wneg (wli ph ps)) (wmd (wneg ph) ps)) (wmd (wneg (wmd (wneg ph) ps)) (wli ph ps))))
          (df_li (ph ps))
          (eac1i ((wmd (wneg (wlb (wli ph ps) (wmd (wneg ph) ps))) (wac (wmd (wneg (wli ph ps)) (wmd (wneg ph) ps)) (wmd (wneg (wmd (wneg ph) ps)) (wli ph ps)))) (wmd (wneg (wac (wmd (wneg (wli ph ps)) (wmd (wneg ph) ps)) (wmd (wneg (wmd (wneg ph) ps)) (wli ph ps)))) (wlb (wli ph ps) (wmd (wneg ph) ps))))
            (df_lb ((wli ph ps) (wmd (wneg ph) ps)))))))
    (df_li ((wlb ph ps) (wli ph ps)))))

--| Extract reverse implication from biconditional. Syllogism form of ~ lb2i .
(pub theorem lbi2s ((ph wff ()) (ps wff ()))
  ()
  (wli (wlb ph ps) (wli ps ph))
  ()
  (lb2i ((wli (wlb ph ps) (wli ps ph)) (wmd (wneg (wlb ph ps)) (wli ps ph)))
    (ax_cut ((wneg (wlb ph ps)) (wmd (wneg ps) ph) (wli ps ph))
      (ax_eac2 ((wlb ph ps) (wmd (wneg ph) ps) (wmd (wneg ps) ph))
        (eac1i ((wmd (wneg (wlb ph ps)) (wac (wmd (wneg ph) ps) (wmd (wneg ps) ph))) (wmd (wneg (wac (wmd (wneg ph) ps) (wmd (wneg ps) ph))) (wlb ph ps)))
          (df_lb (ph ps))))
      (cut1 ((wlb (wli ps ph) (wmd (wneg ps) ph)) (wmd (wneg (wmd (wneg ps) ph)) (wli ps ph)))
        (df_li (ps ph))
        (ax_eac2 ((wlb (wli ps ph) (wmd (wneg ps) ph)) (wmd (wneg (wli ps ph)) (wmd (wneg ps) ph)) (wmd (wneg (wmd (wneg ps) ph)) (wli ps ph)))
          (eac1i ((wmd (wneg (wlb (wli ps ph) (wmd (wneg ps) ph))) (wac (wmd (wneg (wli ps ph)) (wmd (wneg ps) ph)) (wmd (wneg (wmd (wneg ps) ph)) (wli ps ph)))) (wmd (wneg (wac (wmd (wneg (wli ps ph)) (wmd (wneg ps) ph)) (wmd (wneg (wmd (wneg ps) ph)) (wli ps ph)))) (wlb (wli ps ph) (wmd (wneg ps) ph))))
            (df_lb ((wli ps ph) (wmd (wneg ps) ph)))))))
    (df_li ((wlb ph ps) (wli ps ph)))))

--| Extract forward implication from biconditional. Alternate form of ~ lb1i .
(pub theorem lbi1 ((ph wff ()) (ps wff ()))
  ((lbi1_1 (wlb ph ps)))
  (wli ph ps)
  ()
  (lmp ((wlb ph ps) (wli ph ps))
    lbi1_1
    (lbi1s (ph ps))))

--| Extract reverse implication from biconditional. Alternate form of ~ lb2i .
(pub theorem lbi2 ((ph wff ()) (ps wff ()))
  ((lbi2_1 (wlb ph ps)))
  (wli ps ph)
  ()
  (lmp ((wlb ph ps) (wli ps ph))
    lbi2_1
    (lbi2s (ph ps))))

--| Forward implication of biconditional definition.
(pub theorem dflb1s ((ph wff ()) (ps wff ()))
  ()
  (wli (wlb ph ps) (wac (wli ph ps) (wli ps ph)))
  ()
  (dfli2i ((wlb ph ps) (wac (wli ph ps) (wli ps ph)))
    (ax_iac ((wlb ph ps) (wli ph ps) (wli ps ph))
      (dfli1i ((wlb ph ps) (wli ph ps))
        (lbi1s (ph ps)))
      (dfli1i ((wlb ph ps) (wli ps ph))
        (lbi2s (ph ps))))))

--| Reverse implication of biconditional definition.
(pub theorem dflb2s ((ph wff ()) (ps wff ()))
  ()
  (wli (wac (wli ph ps) (wli ps ph)) (wlb ph ps))
  ()
  (syl ((wac (wli ph ps) (wli ps ph)) (wac (wmd (wneg ph) ps) (wmd (wneg ps) ph)) (wlb ph ps))
    (syl ((wac (wli ph ps) (wli ps ph)) (wac (wmd (wneg ph) ps) (wli ps ph)) (wac (wmd (wneg ph) ps) (wmd (wneg ps) ph)))
      (acm1s ((wli ph ps) (wli ps ph) (wmd (wneg ph) ps))
        (dfli2i ((wli ph ps) (wmd (wneg ph) ps))
          (dfli1 ((wneg (wli ph ps)) ph ps)
            (ax_init ((wli ph ps))))))
      (acm2s ((wmd (wneg ph) ps) (wli ps ph) (wmd (wneg ps) ph))
        (dfli2i ((wli ps ph) (wmd (wneg ps) ph))
          (dfli1 ((wneg (wli ps ph)) ps ph)
            (ax_init ((wli ps ph)))))))
    (dfli2i ((wac (wmd (wneg ph) ps) (wmd (wneg ps) ph)) (wlb ph ps))
      (eac2i ((wmd (wneg (wlb ph ps)) (wac (wmd (wneg ph) ps) (wmd (wneg ps) ph))) (wmd (wneg (wac (wmd (wneg ph) ps) (wmd (wneg ps) ph))) (wlb ph ps)))
        (df_lb (ph ps))))))

--| Nicer definition of biconditional. Uses `O-O` and `-O`.
(pub theorem dflb ((ph wff ()) (ps wff ()))
  ()
  (wlb (wlb ph ps) (wac (wli ph ps) (wli ps ph)))
  ()
  (lmp ((wac (wli (wlb ph ps) (wac (wli ph ps) (wli ps ph))) (wli (wac (wli ph ps) (wli ps ph)) (wlb ph ps))) (wlb (wlb ph ps) (wac (wli ph ps) (wli ps ph))))
    (iaci ((wli (wlb ph ps) (wac (wli ph ps) (wli ps ph))) (wli (wac (wli ph ps) (wli ps ph)) (wlb ph ps)))
      (dflb1s (ph ps))
      (dflb2s (ph ps)))
    (dflb2s ((wlb ph ps) (wac (wli ph ps) (wli ps ph))))))

--| Contrapositive rule for linear implication. This follows quite neatly from ~df-li .
(pub theorem licon ((ph wff ()) (ps wff ()))
  ()
  (wli (wli ph ps) (wli (wneg ps) (wneg ph)))
  ()
  (syl ((wli ph ps) (wmd (wneg ph) ps) (wli (wneg ps) (wneg ph)))
    (lb1s ((wli ph ps) (wli ph ps) (wmd (wneg ph) ps))
      (id ((wli ph ps)))
      (df_li (ph ps)))
    (lb2s ((wmd (wneg ph) ps) (wli (wneg ps) (wneg ph)) (wmd (wneg (wneg ps)) (wneg ph)))
      (dfli2i ((wmd (wneg ph) ps) (wmd (wneg (wneg ps)) (wneg ph)))
        (mdcod ((wneg ph) (wneg (wneg ps)) (wneg (wmd (wneg ph) ps)))
          (dfli1i ((wmd (wneg ph) ps) (wmd (wneg ph) (wneg (wneg ps))))
            (mdm2s ((wneg ph) ps (wneg (wneg ps)))
              (dnis (ps))))))
      (df_li ((wneg ps) (wneg ph))))))

--| Deduction form of ~licon .
(pub theorem licond ((ph wff ()) (ps wff ()) (ch wff ()))
  ((licond_1 (wmd ch (wli ph ps))))
  (wmd ch (wli (wneg ps) (wneg ph)))
  ()
  (dfli2 (ch (wneg ps) (wneg ph))
    (mdcod ((wneg ph) (wneg (wneg ps)) ch)
      (mdasi (ch (wneg ph) (wneg (wneg ps)))
        (dnid ((wmd ch (wneg ph)) ps)
          (mdasri (ch (wneg ph) ps)
            (dfli1 (ch ph ps)
              licond_1)))))))

--| Construct a biconditional from its forward and reverse implications.
(pub theorem ilb ((ph wff ()) (ps wff ()))
  ((ilb_1 (wli ph ps))
    (ilb_2 (wli ps ph)))
  (wlb ph ps)
  ()
  (lb2i ((wlb ph ps) (wac (wli ph ps) (wli ps ph)))
    (iaci ((wli ph ps) (wli ps ph))
      ilb_1
      ilb_2)
    (dflb (ph ps))))

--| Construct a biconditional from its forward and reverse implications.
(pub theorem ilbd ((ph wff ()) (ps wff ()) (ch wff ()))
  ((ilbd_1 (wli ph (wli ps ch)))
    (ilbd_2 (wli ph (wli ch ps))))
  (wli ph (wlb ps ch))
  ()
  (dfli2i (ph (wlb ps ch))
    (lb2d ((wneg ph) (wlb ps ch) (wac (wli ps ch) (wli ch ps)))
      (ax_iac (ph (wli ps ch) (wli ch ps))
        (dfli1i (ph (wli ps ch))
          ilbd_1)
        (dfli1i (ph (wli ch ps))
          ilbd_2))
      (dflb (ps ch)))))

--| Linear biconditional is reflexive. This could be thought of as "both directions" of ~id .
(pub theorem lbrf ((ph wff ()))
  ()
  (wlb ph ph)
  ()
  (ilb (ph ph)
    (id (ph))
    (id (ph))))

--| Linear biconditional is Euclidean. Inference for ~lbeu .
(pub theorem lbeui ((ph wff ()) (ps wff ()) (ch wff ()))
  ((lbeui_1 (wlb ph ps))
    (lbeui_2 (wlb ph ch)))
  (wlb ps ch)
  ()
  (ilb (ps ch)
    (syl (ps ph ch)
      (lbi2 (ph ps)
        lbeui_1)
      (lbi1 (ph ch)
        lbeui_2))
    (syl (ch ph ps)
      (lbi2 (ph ch)
        lbeui_2)
      (lbi1 (ph ps)
        lbeui_1))))

--| Linear biconditional is symmetric. Inference for ~lbsym .
(pub theorem lbsymi ((ph wff ()) (ps wff ()))
  ((lbsymi_1 (wlb ph ps)))
  (wlb ps ph)
  ()
  (lbeui (ph ps ph)
    lbsymi_1
    (lbrf (ph))))

--| Linear biconditional is transitive. Inference for ~lbtr .
(pub theorem lbtri ((ph wff ()) (ps wff ()) (ch wff ()))
  ((lbtri_1 (wlb ph ps))
    (lbtri_2 (wlb ps ch)))
  (wlb ph ch)
  ()
  (lbeui (ps ph ch)
    (lbsymi (ph ps)
      lbtri_1)
    lbtri_2))

--| Linear biconditional is symmetric. Deduction for ~lbsym .
(pub theorem lbsymd ((ph wff ()) (ps wff ()) (ch wff ()))
  ((lbsymd_1 (wli ph (wlb ps ch))))
  (wli ph (wlb ch ps))
  ()
  (ilbd (ph ch ps)
    (dfli2i (ph (wli ch ps))
      (ax_eac2 (ph (wli ps ch) (wli ch ps))
        (lb1d ((wneg ph) (wlb ps ch) (wac (wli ps ch) (wli ch ps)))
          (dfli1i (ph (wlb ps ch))
            lbsymd_1)
          (dflb (ps ch)))))
    (dfli2i (ph (wli ps ch))
      (ax_eac1 (ph (wli ps ch) (wli ch ps))
        (lb1d ((wneg ph) (wlb ps ch) (wac (wli ps ch) (wli ch ps)))
          (dfli1i (ph (wlb ps ch))
            lbsymd_1)
          (dflb (ps ch)))))))

--| One, the unit of `(X)`. Defined by ~df-one .
(term wone () (wff ()))

--| One is the dual of Bottom.
(axiom df_one ()
  ()
  (wlb (wone) (wneg (wbot))))

--| Times, multiplicative conjunction. Defined by ~df-mc .
(term wmc ((ph wff ()) (ps wff ())) (wff ()))

--| Times is the dual of Par.
(axiom df_mc ((ph wff ()) (ps wff ()))
  ()
  (wlb (wmc ph ps) (wneg (wmd (wneg ph) (wneg ps)))))

--| Double negation elimination and introduction.
(pub theorem dn ((ph wff ()))
  ()
  (wlb ph (wneg (wneg ph)))
  ()
  (ilb (ph (wneg (wneg ph)))
    (dnis (ph))
    (dnes (ph))))

--| `%` is commutative.
(pub theorem mdco ((ph wff ()) (ps wff ()))
  ()
  (wli (wmd ph ps) (wmd ps ph))
  ()
  (dfli2i ((wmd ph ps) (wmd ps ph))
    (mdcod (ph ps (wneg (wmd ph ps)))
      (ax_init ((wmd ph ps))))))

--| `%` is commutative. Biconditional version of ~mdco .
(pub theorem mdcob ((ph wff ()) (ps wff ()))
  ()
  (wlb (wmd ph ps) (wmd ps ph))
  ()
  (ilb ((wmd ph ps) (wmd ps ph))
    (mdco (ph ps))
    (mdco (ps ph))))

--| `%` is associative.
(pub theorem mdas ((ph wff ()) (ps wff ()) (ch wff ()))
  ()
  (wli (wmd (wmd ph ps) ch) (wmd ph (wmd ps ch)))
  ()
  (dfli2i ((wmd (wmd ph ps) ch) (wmd ph (wmd ps ch)))
    (ax_mdas (ph ps ch))))

--| `_|_` is the unit of `%` (left side).
(pub theorem md1 ((ph wff ()))
  ()
  (wlb ph (wmd (wbot) ph))
  ()
  (ilb (ph (wmd (wbot) ph))
    (dfli2i (ph (wmd (wbot) ph))
      (mdcod (ph (wbot) (wneg ph))
        (mdasi ((wneg ph) ph (wbot))
          (mdcoi ((wbot) (wmd (wneg ph) ph))
            (ax_ibot ((wmd (wneg ph) ph))
              (ax_init (ph)))))))
    (dfli2i ((wmd (wbot) ph) ph)
      (ebotr ((wmd (wneg (wmd (wbot) ph)) ph))
        (mdasri ((wneg (wmd (wbot) ph)) ph (wbot))
          (mdcod ((wbot) ph (wneg (wmd (wbot) ph)))
            (ax_init ((wmd (wbot) ph)))))))))

--| `_|_` is the unit of `%` (right side).
(pub theorem md2 ((ph wff ()))
  ()
  (wlb ph (wmd ph (wbot)))
  ()
  (ilb (ph (wmd ph (wbot)))
    (syl (ph (wmd (wbot) ph) (wmd ph (wbot)))
      (lbi1 (ph (wmd (wbot) ph))
        (md1 (ph)))
      (lbi2 ((wmd ph (wbot)) (wmd (wbot) ph))
        (mdcob (ph (wbot)))))
    (lb2s ((wmd ph (wbot)) ph (wmd (wbot) ph))
      (lbi1 ((wmd ph (wbot)) (wmd (wbot) ph))
        (mdcob (ph (wbot))))
      (md1 (ph)))))

--| `(X)` is commutative. TODO extract double negation theorems, ~licon alternate forms
(pub theorem mcco ((ph wff ()) (ps wff ()))
  ()
  (wli (wmc ph ps) (wmc ps ph))
  ()
  (lb2s ((wmc ph ps) (wmc ps ph) (wneg (wmd (wneg ps) (wneg ph))))
    (syl ((wmc ph ps) (wneg (wneg (wmc ph ps))) (wneg (wmd (wneg ps) (wneg ph))))
      (dnis ((wmc ph ps)))
      (lmp ((wli (wmd (wneg ps) (wneg ph)) (wneg (wmc ph ps))) (wli (wneg (wneg (wmc ph ps))) (wneg (wmd (wneg ps) (wneg ph)))))
        (syl ((wmd (wneg ps) (wneg ph)) (wmd (wneg ph) (wneg ps)) (wneg (wmc ph ps)))
          (dfli2i ((wmd (wneg ps) (wneg ph)) (wmd (wneg ph) (wneg ps)))
            (ax_mdco ((wneg ps) (wneg ph))))
          (syl ((wmd (wneg ph) (wneg ps)) (wneg (wneg (wmd (wneg ph) (wneg ps)))) (wneg (wmc ph ps)))
            (dnis ((wmd (wneg ph) (wneg ps))))
            (lmp ((wli (wmc ph ps) (wneg (wmd (wneg ph) (wneg ps)))) (wli (wneg (wneg (wmd (wneg ph) (wneg ps)))) (wneg (wmc ph ps))))
              (lb1s ((wmc ph ps) (wmc ph ps) (wneg (wmd (wneg ph) (wneg ps))))
                (id ((wmc ph ps)))
                (df_mc (ph ps)))
              (licon ((wmc ph ps) (wneg (wmd (wneg ph) (wneg ps))))))))
        (licon ((wmd (wneg ps) (wneg ph)) (wneg (wmc ph ps))))))
    (df_mc (ps ph))))

--| `(X)` is commutative. Biconditional version of ~mcco .
(pub theorem mccob ((ph wff ()) (ps wff ()))
  ()
  (wlb (wmc ph ps) (wmc ps ph))
  ()
  (ilb ((wmc ph ps) (wmc ps ph))
    (mcco (ph ps))
    (mcco (ps ph))))

--| Zero, the unit of `(+)`. Defined by ~df-zero .
(term wzero () (wff ()))

--| Zero is the dual of Top.
(axiom df_zero ()
  ()
  (wlb (wzero) (wneg (wtop))))

--| Plus, additive disjunction. Defined by ~df-ad .
(term wad ((ph wff ()) (ps wff ())) (wff ()))

--| Plus is the dual of With.
(axiom df_ad ((ph wff ()) (ps wff ()))
  ()
  (wlb (wad ph ps) (wneg (wac (wneg ph) (wneg ps)))))

--| "Of course", positive exponential. Defined by ~df-pe .
(term wpe ((ph wff ())) (wff ()))

--| "Of course" is the dual of "Why not".
(axiom df_pe ((ph wff ()))
  ()
  (wlb (wpe ph) (wneg (wne (wneg ph)))))

--| Absorption of Plus into With. Together with ~abs2 , this shows the additive operators form a lattice.
(pub theorem abs1 ((ph wff ()) (ps wff ()))
  ()
  (wlb (wad ph (wac ph ps)) ph)
  ()
  (lb2i ((wlb (wad ph (wac ph ps)) ph) (wac (wli (wad ph (wac ph ps)) ph) (wli ph (wad ph (wac ph ps)))))
    (iaci ((wli (wad ph (wac ph ps)) ph) (wli ph (wad ph (wac ph ps))))
      (syl ((wad ph (wac ph ps)) (wneg (wac (wneg ph) (wneg (wac ph ps)))) ph)
        (lbi1 ((wad ph (wac ph ps)) (wneg (wac (wneg ph) (wneg (wac ph ps)))))
          (df_ad (ph (wac ph ps))))
        (dfli2i ((wneg (wac (wneg ph) (wneg (wac ph ps)))) ph)
          (dned ((wneg (wneg (wac (wneg ph) (wneg (wac ph ps))))) ph)
            (mdcoi ((wneg (wneg ph)) (wneg (wneg (wac (wneg ph) (wneg (wac ph ps))))))
              (dnid ((wneg (wneg ph)) (wac (wneg ph) (wneg (wac ph ps))))
                (ax_iac ((wneg ph) (wneg ph) (wneg (wac ph ps)))
                  (ax_init ((wneg ph)))
                  (mdcoi ((wneg (wac ph ps)) (wneg (wneg ph)))
                    (dnid ((wneg (wac ph ps)) ph)
                      (ax_eac1 ((wac ph ps) ph ps)
                        (ax_init ((wac ph ps))))))))))))
      (lb2s (ph (wad ph (wac ph ps)) (wneg (wac (wneg ph) (wneg (wac ph ps)))))
        (dfli2i (ph (wneg (wac (wneg ph) (wneg (wac ph ps)))))
          (mdcoi ((wneg (wac (wneg ph) (wneg (wac ph ps)))) (wneg ph))
            (eac1d ((wneg (wac (wneg ph) (wneg (wac ph ps)))) (wneg ph) (wneg (wac ph ps)))
              (ax_init ((wac (wneg ph) (wneg (wac ph ps))))))))
        (df_ad (ph (wac ph ps)))))
    (dflb ((wad ph (wac ph ps)) ph))))

--| Logical implication. Defined by ~df-im .
(term wim ((ph wff ()) (ps wff ())) (wff ()))

--| Definition of `->`. It's `-O` but with some `!` splashed in for good measure. Note that only `ph` needs the exponential. When this statement is beneath a `!` or at the top level, this is equivalent to both sides having the exponential, because of
(axiom df_im ((ph wff ()) (ps wff ()))
  ()
  (wlb (wim ph ps) (wli (wpe ph) ps)))

--| Logical conjunction. Defined by ~df-and .
(term wand ((ph wff ()) (ps wff ())) (wff ()))

--| Definition of `/\`. It's `&` but with some `!` splashed in for good measure.
(axiom df_and ((ph wff ()) (ps wff ()))
  ()
  (wlb (wand ph ps) (wac (wpe ph) (wpe ps))))

--| Logical disjunction. Defined by ~df-or .
(term wor ((ph wff ()) (ps wff ())) (wff ()))

--| Definition of `\/`. It's `(+)` but with some `!` splashed in for good measure.
(axiom df_or ((ph wff ()) (ps wff ()))
  ()
  (wlb (wor ph ps) (wad (wpe ph) (wpe ps))))

--| Logical negation. Defined by ~df-not .
(term wnot ((ph wff ())) (wff ()))

--| Definition of `-.`. It's `~` but with some `!` splashed in for good measure.
(axiom df_not ((ph wff ()))
  ()
  (wlb (wnot ph) (wneg (wpe ph))))

--| Logical biconditional. Defined by ~df-bi .
(term wbi ((ph wff ()) (ps wff ())) (wff ()))

--| Definition of `<->`, in terms of the other logical connectives.
(axiom df_bi ((ph wff ()) (ps wff ()))
  ()
  (wlb (wbi ph ps) (wand (wim ph ps) (wim ps ph))))

--| A variable can be used as a nilad.
(term nvar ((x var ())) (nilad ()))

--| Sending operator. Writes `Y` to the channel `X`.
(term wse ((ph wff ()) (X nilad ()) (Y nilad ())) (wff ()))

--| Recieving operator. Reads from `X` and scopes the result to `y`.
(term wre ((ph wff ()) (y var ()) (X nilad ())) (wff ()))

--| Creation operator. Creates and scopes a new channel `x`. It also has a dual ` ~ v. x ~ ph `, which has a meaning I don't quite understand.
(term wnu ((ph wff ()) (x var ())) (wff ()))

--| Proper substitution of `x` with `Y`. Although used as a primitive token in the axioms, it can actually be treated as a defined symbol; see ~dfsub . See ~nsub for proper substitution in nilads.
(term wsub ((ph wff ()) (x var ()) (Y nilad ())) (wff ()))

--| Generalization. An "anti variable abstraction" can be removed from a "top-level" wff. What does that even mean?
(axiom ax_int ((ph wff ()) (x var ()))
  (ph)
  (wneg (wnu (wneg ph) x)))

--| A variable abstraction can be eliminated if the expression is free in that variable.
(axiom ax_nue ((ph wff ()) (x var ()))
  ()
  (wli (wnu ph x) ph))

--| x is free in ` v. x `.
(axiom ax_nuf ((ph wff ()) (x var ()))
  ()
  (wli (wnu (wnu ph x) x) (wnu ph x)))

--| x is free in ` [ a >> x ] `.
(axiom ax_ref ((ph wff ()) (a var ()) (x var ()))
  ()
  (wli (wnu (wre ph x (nvar a)) x) (wre ph x (nvar a))))

--| x is free in ` ~ v. x ph `. There's that weird "anti variable abstraction" again...
(axiom ax_nnuf ((ph wff ()) (x var ()))
  ()
  (wli (wnu (wneg (wnu ph x)) x) (wneg (wnu ph x))))

--| A wff can be surrounded by a variable abstraction
(axiom ax_nui ((ph wff ()) (x var ()))
  ()
  (wli ph (wnu ph x)))

--| Variables can be renamed without changing the meaning of an expression.
(axiom ax_nur ((ph wff ()) (u var ()) (x var ()) (y var ()))
  ()
  (wli (wnu (wse ph (nvar u) (nvar x)) x) (wnu (wse ph (nvar u) (nvar y)) y)))

--| Commutation of `v.` with `<<`.
(axiom ax_nuse ((ph wff ()) (u var ()) (v var ()) (x var ()))
  ()
  (wlb (wnu (wse ph (nvar u) (nvar v)) x) (wse (wnu ph x) (nvar u) (nvar v))))

--| Commutation of `v.` with `>>`.
(axiom ax_nure ((ph wff ()) (u var ()) (v var ()) (x var ()))
  ()
  (wlb (wnu (wre ph v (nvar u)) x) (wre (wnu ph x) v (nvar u))))

--| Distribution of `v.` over `(+)`.
(axiom ax_nuad ((ph wff ()) (ps wff ()) (x var ()))
  ()
  (wlb (wnu (wad ph ps) x) (wad (wnu ph x) (wnu ps x))))

--| Commutation of `v.` into `(X)`. Note that `x` can only be bound in one factor.
(axiom ax_numc ((ph wff ()) (ps wff ()) (x var ()))
  ()
  (wlb (wnu (wmc ph (wnu ps x)) x) (wmc (wnu ph x) (wnu ps x))))

--| Commutation of `v.` with `v.`. There is no need for a distinct variable condition on `x` and `y`, since ` ( v. x v. x ph O-O v. x v. x ph ) ` is a valid theorem.
(axiom ax_nunu ((ph wff ()) (x var ()) (y var ()))
  ()
  (wlb (wnu (wnu ph y) x) (wnu (wnu ph x) y)))

(axiom ax_subse1 ((ph wff ()) (a var ()) (x var ()) (y var ()))
  ()
  (wlb (wsub (wse ph (nvar x) (nvar a)) x (nvar y)) (wsub (wse ph (nvar y) (nvar a)) x (nvar y))))

(axiom ax_subse2 ((ph wff ()) (a var ()) (x var ()) (y var ()))
  ()
  (wlb (wsub (wse ph (nvar a) (nvar x)) x (nvar y)) (wsub (wse ph (nvar a) (nvar y)) x (nvar y))))

(axiom ax_subse3 ((ph wff ()) (u var ()) (v var ()) (x var ()) (y var ()))
  ()
  (wlb (wsub (wse ph (nvar u) (nvar v)) x (nvar y)) (wse (wsub ph x (nvar y)) (nvar u) (nvar v))))

(axiom ax_subre1 ((ph wff ()) (a var ()) (x var ()) (y var ()))
  ()
  (wlb (wsub (wre ph a (nvar x)) x (nvar y)) (wsub (wre ph a (nvar y)) x (nvar y))))

(axiom ax_subre2 ((ph wff ()) (u var ()) (v var ()) (x var ()) (y var ()))
  ()
  (wlb (wsub (wre ph v (nvar u)) x (nvar y)) (wre (wsub ph x (nvar y)) v (nvar u))))

(axiom ax_subnu1 ((ph wff ()) (x var ()) (y var ()))
  ()
  (wlb (wsub (wnu ph x) x (nvar y)) (wnu ph x)))

(axiom ax_subnu2 ((ph wff ()) (u var ()) (x var ()) (y var ()))
  ()
  (wlb (wsub (wnu ph u) x (nvar y)) (wnu (wsub ph x (nvar y)) u)))

(axiom ax_subid ((ph wff ()) (x var ()))
  ()
  (wlb (wsub ph x (nvar x)) ph))

--| Message passing.
(axiom ax_send ((ph wff ()) (ps wff ()) (x var ()) (y var ()) (z var ()))
  ()
  (wli (wmc (wse ph (nvar z) (nvar y)) (wre ps x (nvar z))) (wmc ph (wsub ps x (nvar y)))))

--| Reading from a channel with nothing writing to it causes a deadlock.
(axiom ax_lock1 ((a var ()) (x var ()))
  ()
  (wli (wnu (wne (wre (wone) a (nvar x))) x) (wzero)))

--| Writing to a channel with nothing reading from it causes a deadlock.
(axiom ax_lock2 ((a var ()) (x var ()))
  ()
  (wli (wnu (wne (wse (wone) (nvar x) (nvar a))) x) (wzero)))

--| Dual write operator.
(term wnse ((ph wff ()) (X nilad ()) (Y nilad ())) (wff ()))

--| Dual read operator.
(term wnre ((ph wff ()) (y var ()) (X nilad ())) (wff ()))

--| Dual creation operator.
(term wnnu ((ph wff ()) (x var ())) (wff ()))

--| Definition of the dual write operator.
(axiom df_nse ((ph wff ()) (X nilad ()) (Y nilad ()))
  ()
  (wlb (wnse ph X Y) (wneg (wse (wneg ph) X Y))))

--| Definition of the dual read operator.
(axiom df_nre ((ph wff ()) (y var ()) (X nilad ()))
  ()
  (wlb (wnre ph y X) (wneg (wre (wneg ph) y X))))

--| Definition of the dual creation operator.
(axiom df_nnu ((ph wff ()) (x var ()))
  ()
  (wlb (wnnu ph x) (wneg (wnu (wneg ph) x))))

--| Nilad equality.
(term weq ((X nilad ()) (Y nilad ())) (wff ()))

--| Definition of channel equality. Two nilads are equivalent if, when written to an arbitrary channel, that channel behaves the same way. We measure this by seeing if we can successfully read from it.
(axiom df_eq ((a var ()) (b var ()) (X nilad ()) (Y nilad ()))
  ()
  (wlb (weq X Y) (wnnu (wlb (wse (wre (wone) b (nvar a)) (nvar a) X) (wse (wre (wone) b (nvar a)) (nvar a) Y)) a)))

--| A nilad abstraction. When used where a variable would normally belong, the variable used is instead the first one written by `ph` to `x`. (Any other operations on `x` will block indefinitely, as they would on a fresh channel.) This is a very useful concept, since this allows us to reason about expressions which carry values. Keep in mind that these must be treated linearly like everything else, so using nilad variables multiple times may carry unintended consequences. Use `:=` as necessary to avoid this. The nilad abstraction is characterized by ~df-nab .
(term nnab ((ph wff ()) (x var ())) (nilad ()))

--| Using a nilad abstraction is the same as running the associated process `ph` and using its "return value" instead. Since the input to all other operators can be modeled using `<<`, this is enough to fully describe nilad abstractions. Unlike most defined operators, the nilad abstraction cannot directly be expanded to primitive symbols. Despite this, it is always possible to mechanically eliminate nilads from any expression that contains them by simply moving the process `ph` to before the variable `y` is used.
(axiom df_nab ((ph wff ()) (ps wff ()) (a var ()) (x var ()) (y var ()))
  ()
  (wlb (wse ps (nvar x) (nnab ph y)) (wmc ph (wre (wse ps (nvar x) (nvar a)) a (nvar y)))))

--| A simple nilad abstraction. Ordinary nilad abstractions use the bound channel as a sort of return channel, while this version immediately returns a fresh channel.
(term nvnab ((ph wff ()) (x var ())) (nilad ()))

--| Definition of simple nilads.
(axiom df_vnab ((ph wff ()) (r var ()) (x var ()))
  ()
  (weq (nvnab ph x) (nnab (wnu (wse ph (nvar r) (nvar x)) x) r)))

--| Proper substitution of `x` with `Y` in the nilad `A`. See also ~wsub .
(term nsub ((x var ()) (A nilad ()) (Y nilad ())) (nilad ()))

--| The proper substitution of `x` with `Y` in `F`.
(axiom df_nsub ((a var ()) (f var ()) (r var ()) (x var ()) (y var ()) (F nilad ()) (Y nilad ()))
  ()
  (wsub (weq F (nnab (wnu (wsub (wre (wse (wone) (nvar r) (nvar f)) f F) x (nvar y)) a) r)) x Y))

--| Lambda abstraction.
(term nla ((x var ()) (Y nilad ())) (nilad ()))

--| Definition of lambda abstraction. The lambda exposes a "handle" `f` which reads a temporary communication channel `a`. The resulting function's input `x` and output `Y` are passed along `a`. The `!` exponential creates infinite instances of this function "provider", which can all run in parallel. Compare with ~df-fv to see how this function is called.
(axiom df_la ((a var ()) (f var ()) (x var ()) (Y nilad ()))
  ()
  (weq (nla x Y) (nvnab (wpe (wre (wre (wse (wone) (nvar a) Y) x (nvar a)) a (nvar f))) f)))

--| Function application.
(term nfv ((F nilad ()) (X nilad ())) (nilad ()))

--| Definition of function application. This sends a temporary communication channel `a` to `F`, and communicates the input `X` and output `y`. Compare with ~df-la to see how functions are defined.
(axiom df_fv ((a var ()) (r var ()) (y var ()) (F nilad ()) (X nilad ()))
  ()
  (weq (nfv F X) (nnab (wnu (wse (wse (wre (wse (wone) (nvar r) (nvar y)) y (nvar a)) (nvar a) X) F (nvar a)) a) r)))

--| Operator application.
(term nov ((A nilad ()) (B nilad ()) (F nilad ())) (nilad ()))

--| Definition of operator application. It's simply two curried function applications.
(axiom df_ov ((A nilad ()) (B nilad ()) (F nilad ()))
  ()
  (weq (nov A B F) (nfv (nfv F A) B)))

--| S combinator, the input distributor.
(term nss () (nilad ()))

--| K combinator, the constant generator.
(term nkk () (nilad ()))

--| I combinator, the identity function.
(term nii () (nilad ()))

--| Iota combinator, from which the S, K, and I combinators can be derived.
(term niota () (nilad ()))

--| Definition of the S combinator.
(axiom df_ss ((a var ()) (b var ()) (c var ()))
  ()
  (weq (nss) (nla a (nla b (nla c (nfv (nfv (nvar b) (nvar a)) (nfv (nvar c) (nvar a))))))))

--| Definition of the K combinator.
(axiom df_kk ((a var ()) (b var ()))
  ()
  (weq (nkk) (nla a (nla b (nvar a)))))

--| Definition of the I combinator.
(axiom df_ii ((a var ()))
  ()
  (weq (nii) (nla a (nvar a))))

--| Definition of the iota combinator in terms of `SS` and `KK`.
(axiom df_iota ((f var ()))
  ()
  (weq (niota) (nla f (nfv (nfv (nvar f) (nss)) (nkk)))))

--| Function representing truth.
(term ntru () (nilad ()))

--| Function representing falsity.
(term nfal () (nilad ()))

--| Church-encoding of truth. It takes two (curried) arguments and returns the first. Happens to be identical to ~nkk .
(axiom df_tru ((x var ()) (y var ()))
  ()
  (weq (ntru) (nla x (nla y (nvar x)))))

--| Church-encoding of falsity. It takes two (curried) arguments and returns the second.
(axiom df_fal ((x var ()) (y var ()))
  ()
  (weq (nfal) (nla x (nla y (nvar y)))))

--| Truth judgement.
(term weqtru ((P nilad ())) (wff ()))

--| Falsity judgement.
(term weqfal ((P nilad ())) (wff ()))

--| A shorthand way of saying that a church-encoded value is true. I would totally use this as a new typecode, so I could prove statements with `|=` instead of `|-`, but it turns out that adds needless complexity (and mmj2 doesn't like it).
(axiom df_eqtru ((P nilad ()))
  ()
  (wlb (weq P (ntru)) (weqtru P)))

--| A shorthand way of saying that a church-encoded value is false. Note that this is not the opposite of ~df-eqtru (although they do exclude each other), since there are many more things an expression could equal.
(axiom df_eqfal ((P nilad ()))
  ()
  (wlb (weq P (nfal)) (weqfal P)))

--| Function representing logical implication.
(term nlimpl () (nilad ()))

--| Function representing logical conjunction.
(term nland () (nilad ()))

--| Function representing logical disjunction.
(term nlor () (nilad ()))

--| Function representing logical negation.
(term nlnot () (nilad ()))

--| Function representing logical biconditional.
(term nliff () (nilad ()))

--| Church-encoding of logical conjunction.
(axiom df_limpl ((a var ()) (b var ()))
  ()
  (weq (nlimpl) (nla a (nla b (nov (nvar b) (ntru) (nvar a))))))

--| Church-encoding of logical conjunction.
(axiom df_land ((a var ()) (b var ()))
  ()
  (weq (nland) (nla a (nla b (nov (nvar b) (nfal) (nvar a))))))

--| Church-encoding of logical disjunction.
(axiom df_lor ((a var ()) (b var ()))
  ()
  (weq (nlor) (nla a (nla b (nov (ntru) (nvar b) (nvar a))))))

--| Church-encoding of logical negation.
(axiom df_lnot ((a var ()) (x var ()) (y var ()))
  ()
  (weq (nlnot) (nla a (nla x (nla y (nov (nvar y) (nvar x) (nvar a)))))))

--| Church-encoding of logical biconditional.
(axiom df_liff ((a var ()) (b var ()))
  ()
  (weq (nliff) (nla a (nla b (nov (nvar b) (nfv (nlnot) (nvar b)) (nvar a))))))

--| Universal quantifier. Characterized by ~ax-genOLD , ~ax-almd , ~ax-dis , ~ax-ex , ~ax-negf , ~ax-alcom .
(term wal ((ph wff ()) (x var ())) (wff ()))

--| Existential quantifier. Defined by ~df-ex .
(term wex ((ph wff ()) (x var ())) (wff ()))

--| Not-free predicate. Defined by ~df-nf .
(term wnf ((ph wff ()) (x var ())) (wff ()))

--| Set element predicate. For the purposes of predicate logic, it's just an arbitrary operator.
(term wel ((x var ()) (y var ())) (wff ()))

--| Axiom of generalization. Universal quantifiers can be freely added to the start of an expression.
(axiom ax_genOLD ((ph wff ()) (x var ()))
  (ph)
  (wal ph x))

--| Quantified multiplicative disjunction. This "distributes" a quantifier over linear implication.
(axiom ax_almd ((ph wff ()) (ps wff ()) (x var ()))
  ()
  (wli (wal (wli ph ps) x) (wli (wal ph x) (wal ps x))))

--| Distinctness principle. When the value of `ph` is independent of `x`, a quantifier can be added.
(axiom ax_dis ((ph wff ()) (x var ()))
  ()
  (wli ph (wal ph x)))

--| Axiom of existence. This axiom is secretly two useful axioms in one. It states that any `y` has an `x` that is equal to it. It also states that there exists something equal to itself, when `y` is substituted for `x`.
(axiom ax_ex ((x var ()) (y var ()))
  ()
  (wneg (wal (wneg (weq (nvar x) (nvar y))) x)))

--| Equality is Euclidean. Combined with ~ax-ex , this implies that equality is symmetric and transitive.
(axiom ax_eqeu ((x var ()) (y var ()) (z var ()))
  ()
  (wli (weq (nvar x) (nvar y)) (wli (weq (nvar x) (nvar z)) (weq (nvar y) (nvar z)))))

--| Left equality for binary predicate. This consumes the equality.
(axiom ax_eleq1 ((x var ()) (y var ()) (z var ()))
  ()
  (wli (weq (nvar x) (nvar y)) (wli (wel x z) (wel y z))))

--| Right equality for binary predicate. This consumes the equality.
(axiom ax_eleq2 ((x var ()) (y var ()) (z var ()))
  ()
  (wli (weq (nvar x) (nvar y)) (wli (wel z x) (wel z y))))

--| Axiom of quantified negation.
(axiom ax_negf ((ph wff ()) (x var ()))
  ()
  (wli (wneg (wal ph x)) (wal (wneg (wal ph x)) x)))

--| Quantifier commutation.
(axiom ax_alcom ((ph wff ()) (x var ()) (y var ()))
  ()
  (wli (wal (wal ph y) x) (wal (wal ph x) y)))

--| Axiom of variable substitution.
(axiom ax_sub ((ph wff ()) (x var ()) (y var ()))
  ()
  (wli (weq (nvar x) (nvar y)) (wli (wal ph y) (wal (wli (weq (nvar x) (nvar y)) ph) x))))

--| Quantified equality.
(axiom ax_aleq ((x var ()) (y var ()) (z var ()))
  ()
  (wli (wneg (weq (nvar x) (nvar y))) (wli (weq (nvar y) (nvar z)) (wal (weq (nvar y) (nvar z)) x))))

--| Definition of existential quantifier. Dual of `A.`.
(axiom df_ex ((ph wff ()) (x var ()))
  ()
  (wlb (wex ph x) (wneg (wal (wneg ph) x))))

--| Definition of not-free predicate.
(axiom df_nf ((ph wff ()) (x var ()))
  ()
  (wlb (wnf ph x) (wli (wneg ph) (wal ph x))))

