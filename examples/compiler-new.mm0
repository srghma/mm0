-- @mmc-th theorem okReadHypVar
--   (h1: $ okVCtxGet vctx (vVar v ty) $):
--   $ okReadHyp (mkTCtx vctx n mctx) ty $ = 'sorry;

-- @mmc-th theorem okReadHyp_unit:
