delimiter $ ( ) ! = , $;
provable sort wff;
term imp: wff > wff > wff;
infixr imp: $->$ prec 2;

-- The implicational axioms of intuitionistic logic
axiom K (a b: wff): $ a -> b -> a $;
axiom S (a b c: wff): $ (a -> b -> c) -> (a -> b) -> a -> c $;
axiom mp (a b: wff): $ a -> b $ > $ a $ > $ b $;

-- Some basic metafunctions borrowed from peano.mm1

sort nat;
term all {x: nat} (P: wff x): wff;
notation all (x P) = ($!$:4) x P;
term eq (a b: nat): wff;
infixl eq: $=$ prec 10;

axiom refl (a: nat): $ a = a $;
axiom symm (a b: nat): $ a = b $ > $ b = a $;
axiom trans (a b c: nat): $ a = b $ > $ b = c $ > $ a = c $;

axiom foo {x: nat} (P Q: wff x): $ !x(P -> Q) -> !x P -> !x Q $;

term _0: nat; prefix _0: $0$ prec max;
term succ: nat > nat;
axiom succ_eq (a b: nat): $ a = b $ > $ succ a = succ b $;

def _1: nat = $ succ 0 $; prefix _1: $1$ prec max;
def _2: nat = $ succ 1 $; prefix _2: $2$ prec max;
def _3: nat = $ succ 2 $; prefix _3: $3$ prec max;
def _4: nat = $ succ 3 $; prefix _4: $4$ prec max;

term add (a b: nat): nat;
infixl add: $+$ prec 20;
axiom add_eq (a b c d: nat): $ a = b $ > $ c = d $ > $ a + c = b + d $;

axiom add_succ (a b: nat): $ a + succ b = succ (a + b) $;
axiom add_zero (a: nat): $ a + 0 = a $;

